ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice id to use for TTS. Defaults to a stock voice if unset.
ELEVENLABS_VOICE_ID=

# Optional: set to 1 to save everything sent to the APIs (audio, screen images,
# prompt) under sherpa/_debug/ for troubleshooting. Contains screen contents.
SHERPA_DEBUG=

# Optional: set to 0 to hide the per-turn latency line ("Timing: ...") printed to the
# terminal after each answer. On by default; nothing is sent anywhere.
SHERPA_TIMING=

# Optional: set to 0 to stop barge-in in voice mode (talking over Sherpa no longer
# stops her). Useful for testing whether she hears herself through speakers.
SHERPA_BARGE_IN=

# Optional: set to 0 to turn off activity awareness (during a session Sherpa watches
# app/window changes, clicks and what you type, in memory only, and forgets it all when the
# session ends). On by default.
SHERPA_ACTIVITY=

# Audio playback block size in frames (default 1024). 0 lets PortAudio choose tiny blocks,
# which can crackle when other threads are busy.
# SHERPA_PLAYBACK_BLOCK=1024

# Optional: set to 0 to turn off corrections (when you type something that contradicts what you
# asked for, e.g. you said Gmail but typed a hotmail address, Sherpa gently says so). Only active
# in a session, only after you've stated a goal, and only the typed text goes to Claude for the check.
# On by default. Needs activity awareness.
SHERPA_CORRECTIONS=
# SHERPA_CORRECTION_CONFIDENCE=0.8   # how sure the check must be before she speaks (0-1)
# SHERPA_CORRECTION_GOAL_WINDOW_S=600  # how recent your stated goal must be (seconds)

# Session-long screen buffer (memory only, nothing on disk): while a session is active Sherpa
# samples the pointer's display at a low rate and keeps the last ~30s. Set SHERPA_SCREEN_BUFFER=0
# to turn it off (default on); SHERPA_IDLE_FPS sets the base rate (default 1.0; it backs off
# automatically when the screen is idle).
# SHERPA_SCREEN_BUFFER=1
# SHERPA_IDLE_FPS=1.0
